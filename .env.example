# --- Flask ---
# Generate a strong random value for production, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-long-random-string

# Set to True to enable Flask debug mode (local dev only)
FLASK_DEBUG=True

# Port the Flask app listens on (default 5000)
PORT=5000

# --- Google Gemini API (required for translation) ---
# Get a key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-gemini-api-key-here

# Gemini model name, e.g. gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash
GEMINI_MODEL=gemini-1.5-flash

# --- Google Cloud Storage (required for file upload/download) ---
# Your GCP project ID
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Name of the GCS bucket used to stage uploaded/translated files (no gs:// prefix)
GCS_BUCKET_NAME=your-gcs-bucket-name

# --- API authentication ---
# If set, POST /api/v1/translations requires header: X-API-Key: <this value>.
# Leave unset for open local-dev usage.
# API_KEY=generate-with-python-c-import-secrets-print-secrets-token-hex-32

# --- Optional tuning ---
# MAX_CONTENT_LENGTH_BYTES=26214400          # 25 MiB upload cap
# TRANSLATION_THREADS=8                      # concurrent Gemini calls per request
# SIGNED_URL_EXPIRY_MINUTES=5                # download-link lifetime

# Local auth: path to a service account JSON key with Storage Object Admin on the bucket.
# Not needed on Cloud Run / GCE — those use the attached service account automatically.
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account-key.json
